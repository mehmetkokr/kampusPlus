# Backend sunucusunun adresi.
# Backend farklı bir portta çalışıyorsa burayı güncelle.
VITE_API_URL=http://localhost:4000

# Hata takibi (isteğe bağlı): sentry.io'daki projenin DSN adresi. Boşsa
# tarayıcı hataları yalnızca yönetim paneli > Sistem'e gider.
VITE_SENTRY_DSN=

# Sitenin yayındaki adresi ve iletişim e-postası. index.html, robots.txt ve
# sitemap.xml içindeki adresler derlemede bunlarla değiştirilir.
VITE_SITE_URL=
VITE_CONTACT_EMAIL=
