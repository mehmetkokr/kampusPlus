{
  "name": "kampus-app-server",
  "version": "1.0.0",
  "description": "Kampüs Eşleşme ve Sohbet Uygulaması - Backend",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node --watch-path=src src/index.js",
    "start": "node src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio",
    "prisma:seed": "node prisma/seed.js",
    "mail:test": "node scripts/mail-test.js",
    "admin:create": "node scripts/create-admin.js",
    "start:prod": "prisma migrate deploy && node prisma/seed.js --if-empty && node src/index.js",
    "test": "node --test test/lib.test.js test/hardening.test.js test/api.test.js test/features.test.js test/restore.test.js",
    "admin:reset-2fa": "node scripts/reset-2fa.js",
    "backup:restore": "node scripts/restore-backup.js",
    "load-test": "node scripts/load-test.js"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@sentry/node": "^11.6.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "file-type-checker": "^1.1.7",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.0",
    "prisma": "^5.20.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.0",
    "tesseract.js": "^5.1.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "engines": {
    "node": ">=20"
  }
}
