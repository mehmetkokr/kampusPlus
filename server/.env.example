# Veritabanı bağlantı adresi (SQLite - proje klasöründe dev.db dosyası olarak oluşur)
DATABASE_URL="file:./dev.db"

# Sunucu portu (client .env dosyasındaki VITE_API_URL ile uyumlu olmalı)
PORT=4000

# Frontend adresi (CORS için)
CLIENT_URL="http://localhost:5173"

# Sunucu bir ters proxy (nginx, Cloudflare, Render, Railway vb.) arkasında
# çalışıyorsa "true" yapın - aksi halde rate limiter yanlış IP'yi görür.
# Kendi bilgisayarınızda (localhost) çalıştırıyorsanız "false" bırakın.
TRUST_PROXY="false"

# JWT (giriş/oturum) imzalama anahtarı.
# ONEMLI: Bu, rastgele uretilmis guclu bir anahtardir. Prod ortamina gecerken
# kendi anahtarinizi uretin: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Bu anahtari asla paylasmayin veya versiyon kontrolune eklemeyin.
JWT_SECRET=""

# ----------------------------
# E-posta (sifre sifirlama baglantilari icin)
# ----------------------------
# Bu degerler bos birakilirsa, sistem e-posta gondermek yerine sifirlama
# baglantisini sunucu konsoluna yazar (gelistirme modu). Gercek bir SMTP
# hesabi (orn. Gmail App Password, SendGrid, Mailgun) tanimlandiginda
# gercek e-posta gonderimi otomatik olarak devreye girer.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="kampus+ <no-reply@kampusplus.app>"
