# Veritabanı bağlantı adresi (SQLite - proje klasöründe dev.db dosyası olarak oluşur)
DATABASE_URL="file:./dev.db"

# Sunucu portu (client .env dosyasındaki VITE_API_URL ile uyumlu olmalı)
PORT=4000

# Sitenin adresi: e-posta bağlantıları (şifre sıfırlama), sitemap, robots.txt
# ve arama motoru etiketleri (canonical, og:url) bunu kullanır. Yayında alan
# adınızı yazın (ör. https://kampusplus.com.tr). Boşsa sırasıyla CLIENT_URL,
# Railway'in verdiği alan adı (RAILWAY_PUBLIC_DOMAIN), yerelde localhost kullanılır.
SITE_URL=""

# Arayüzün çalıştığı adres (yerel geliştirmede ayrı porttan; CORS için)
CLIENT_URL="http://localhost:5173"

# Ek izinli adresler (virgülle), ör. başka bir alan adından da açılıyorsa
EXTRA_ORIGINS=""

# Sunucu bir ters proxy (nginx, Cloudflare, Render, Railway vb.) arkasında
# çalışıyorsa "true" olmalı - aksi halde rate limiter herkesi aynı IP sanır
# ve giriş sınırı tüm kullanıcılar için birlikte dolar. Boş bırakılırsa
# Railway'de kendiliğinden açık, yerelde kapalıdır.
TRUST_PROXY=""

# JWT (giriş/oturum) imzalama anahtarı.
# ONEMLI: Bu, rastgele uretilmis guclu bir anahtardir. Prod ortamina gecerken
# kendi anahtarinizi uretin: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Bu anahtari asla paylasmayin veya versiyon kontrolune eklemeyin.
JWT_SECRET=""

# ----------------------------
# E-posta (kayit dogrulama kodlari ve sifre sifirlama baglantilari icin)
# ----------------------------
# Bu degerler bos birakilirsa sistem e-posta gondermek yerine kodlari ve
# baglantilari sunucu konsoluna yazar (gelistirme modu). Gercek kullanicilara
# acmadan once MUTLAKA doldurun, yoksa kimse kayit olamaz.
#
# Ornek saglayicilar:
#   Brevo (gunluk 300 ucretsiz): SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587
#   Resend:                      SMTP_HOST=smtp.resend.com     SMTP_PORT=465 SMTP_SECURE=true SMTP_USER=resend
#   Gmail (uygulama sifresi):    SMTP_HOST=smtp.gmail.com      SMTP_PORT=465 SMTP_SECURE=true
#
# Test: npm run mail:test -- ornek@adres.com
# SMTP portlari kapali sunucularda (Railway Hobby vb.) SMTP yerine Brevo API:
#   brevo.com > SMTP & API > API Keys; gonderen adresi Senders bolumunde onaylanmali
BREVO_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="kampüs+ <bildirim@kampusplus.com.tr>"
# Yanıtların gideceği adres (isteğe bağlı; ör. Cloudflare Email Routing ile Gmail'e yönlenen destek adresi)
MAIL_REPLY_TO="destek@kampusplus.com.tr"

# ----------------------------
# Premium ödemeleri
# ----------------------------
# Gerçek ödeme sağlayıcısı (iyzico) henüz bağlı değil; satın alma ödeme
# almadan premium açar. Bu yüzden yayında (NODE_ENV=production veya Railway)
# varsayılan olarak kapalıdır, yerelde açıktır. Boş bırakırsanız bu varsayılan
# geçerlidir; "true" her yerde açar, "false" her yerde kapatır.
MOCK_PAYMENTS=""

# ----------------------------
# Yayın (Railway) için
# ----------------------------
# Yüklenen fotoğraf ve belgelerin klasörü. Railway'de kalıcı diske (Volume)
# yönlendirin, aksi halde her güncellemede silinir. Yerelde boş bırakın.
#   STORAGE_DIR="/data"
#   DATABASE_URL="file:/data/kampus.db"
STORAGE_DIR=""

# ----------------------------
# Veritabanı yedeği
# ----------------------------
# Her gece 03:30'da STORAGE_DIR/backups altına sıkıştırılmış bir yedek alınır;
# yönetim paneli > Sistem'den indirilebilir. Kaç yedek saklanacağı (varsayılan 14):
BACKUP_KEEP=""

# ----------------------------
# Hata takibi (isteğe bağlı)
# ----------------------------
# Hatalar her durumda yönetim paneli > Sistem'de görünür. sentry.io'da ücretsiz
# bir proje açıp DSN adresini buraya yazarsanız sunucu hataları ayrıca Sentry'ye
# de gider. Tarayıcı hataları için client tarafında VITE_SENTRY_DSN kullanılır.
SENTRY_DSN=""

# ----------------------------
# Anlık bildirim (Web Push)
# ----------------------------
# Boş bırakılırsa anahtarlar ilk açılışta üretilip STORAGE_DIR/vapid-keys.json
# dosyasına yazılır (Railway'de kalıcı diskte durur). Bu dosyayı silmeyin:
# anahtar değişirse tüm cihazların bildirim iznini yeniden vermesi gerekir.
# Kendiniz üretmek isterseniz: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Bildirim servislerinin sorun olursa ulaşacağı adres (mailto: ya da https://)
VAPID_SUBJECT="mailto:destek@kampusplus.com.tr"

# ----------------------------
# Yedeklerin dış depoya gönderilmesi (isteğe bağlı, önerilir)
# ----------------------------
# Amazon S3, Cloudflare R2, Backblaze B2 gibi S3 uyumlu bir depo. Hepsi doluysa
# her yedek ayrıca buraya yüklenir. Anahtar yalnızca bu depoya yazabilmeli.
BACKUP_S3_ENDPOINT=""
BACKUP_S3_BUCKET=""
BACKUP_S3_REGION="auto"
BACKUP_S3_ACCESS_KEY_ID=""
BACKUP_S3_SECRET_ACCESS_KEY=""
BACKUP_S3_PREFIX="kampus-backups/"

# ----------------------------
# Yönetici güvenliği
# ----------------------------
# "true" yapılırsa iki adımlı doğrulamayı açmamış yöneticiler panelde yalnızca
# kurulum sayfasını görebilir. Telefonunu kaybeden yönetici için:
#   npm run admin:reset-2fa -- yonetici@ornek.edu.tr
ADMIN_REQUIRE_2FA=""

# ----------------------------
# Yönetici uyarıları
# ----------------------------
# Yeni sunucu hatası, başarısız yedek ve yeni şikâyette yöneticilere e-posta
# (ve bildirimi açıksa anlık bildirim) gider. Boşsa tüm yönetici hesaplarına;
# doluysa yalnızca bu adreslere (virgülle ayır). "off" yalnızca ADMIN_ALERTS için.
ADMIN_ALERT_EMAILS=""
ADMIN_ALERTS=""

# İstek sınırları (varsayılanlar çoğu durumda doğrudur; yalnızca test/yük testi için değiştirin)
# API_RATE_LIMIT=600      # kullanıcı/IP başına 15 dakikada
# LOGIN_RATE_LIMIT=10     # IP başına 15 dakikada giriş denemesi
