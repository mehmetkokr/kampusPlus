# Bağımlılıklar
node_modules/

# Derleme çıktıları
dist/
build/

# Ortam değişkenleri (gizli anahtarlar) — şablon için .env.example kullanın
.env
.env.*
!.env.example

# Yerel veritabanı
server/prisma/*.db
server/prisma/*.db-journal

# Kullanıcı yüklemeleri (fotoğraflar, öğrenci belgeleri)
server/uploads/*
server/private-uploads/*
!server/uploads/.gitkeep
!server/private-uploads/.gitkeep

# Veritabanı yedekleri ve otomatik üretilen anlık bildirim anahtarları (gizli)
server/backups/
server/vapid-keys.json

# Loglar ve sistem dosyaları
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Yerel editör / araç ayarları
.vscode/
.idea/
.claude/

# Yerel deneme hesapları (şifre içerir)
test-accounts.local.txt

# OCR dil verileri (tesseract.js çalışırken kendisi indirir)
*.traineddata

# Uçtan uca test çıktıları
client/test-results/
client/playwright-report/
